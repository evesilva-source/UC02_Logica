programa {
  funcao inicio() {
   // variáveis
   real combustivel, consumo
   inteiro total
   // dados
   escreva("Olá!", "\n")
   escreva("informe a distância total de km: ", total, "\n")
   leia(total)
   escreva("informe os litros de combustível usados: ", combustivel, "\n")
   leia(combustivel)
   // calculo
    consumo = total / combustivel
   // result
    escreva("O consumo médio do carro é: ", consumo , " km/l", "\n")
  }
}
