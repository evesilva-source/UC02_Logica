programa {
  funcao inicio() {
    inteiro arquibancada, cadeiras, total
    escreva("coloque a quantidade de torcedores que estão na arquibancada: ", "\n")
    leia(arquibancada)
    escreva("coloque a quantidade de torcedores que estão nas cadeiras: ", "\n")
    leia(cadeiras)
    total = arquibancada + cadeiras
    escreva("O total no estadio é: ", total, " torcedores")
  }
}
