programa {
    funcao inicio() {
        // variaveis 
        real nota1, nota2, media
        // entrada

        escreva("Digite a nota 1: ")
        leia(nota1)

        escreva("Digite a nota 2: ")
        leia(nota2)
        // processamento

        media = (nota1 + nota2) / 2
        //saida

        escreva("Média: ", media, "\n")
    }
}

