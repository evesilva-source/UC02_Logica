programa {
  funcao inicio() {
   // variaveis
    real semanal, total
    // dados
    escreva("informe o valor semanal que você vai poupar: ", semanal, "\n") 
    leia(semanal)
    // calculo
    total = semanal * 4 
    // resultado
    escreva("O montante total poupado após as 4 semanas é: R$ ", total, "\n") 
  }
}
