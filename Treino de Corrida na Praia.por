programa {
  funcao inicio() {
   // variáveis
   real indo
   inteiro total
   // dados
   escreva("Olá, seja bem vindo(a)!", "\n")
   escreva("informe a distância que o atleta correu na ida km: ", indo, "\n")
   leia(indo)
   // calculo
   total = indo * 2 
   // resultado
   escreva("calculando ...", "\n")
   escreva("A distância total de ida e volta é: ", total, " metros")
  }
}
