programa { 
    funcao inicio() { 
    real largura, comprimento, area 
    escreva("informe a argura (m): \n") 
    leia(largura) 
    escreva("ibnforme o comprimento (m): \n") 
    leia(comprimento) 
// alterei o  + pra * 
    area = largura * comprimento 
    escreva("Área: ", area, " m² \n") 
 } 
}